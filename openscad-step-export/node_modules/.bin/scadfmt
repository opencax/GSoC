#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -x "$basedir//bin/env" ]; then
  exec "$basedir//bin/env" node "$basedir/../openscad-parser/dist/scadfmt.js" "$@"
else 
  exec /bin/env node "$basedir/../openscad-parser/dist/scadfmt.js" "$@"
fi
